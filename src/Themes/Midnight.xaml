<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fonds -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0E14" />
    <SolidColorBrush x:Key="SurfaceBrush"       Color="#151A23" />
    <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="#1C2330" />
    <SolidColorBrush x:Key="CardBorderBrush"    Color="#232B3A" />

    <!-- Textes -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B95A7" />

    <!-- Couleur d'accent (boutons principaux) -->
    <SolidColorBrush x:Key="AccentBrush"        Color="#6366F1" />
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#818CF8" />

    <!-- Statuts -->
    <SolidColorBrush x:Key="OnlineBrush"    Color="#22C55E" />
    <SolidColorBrush x:Key="RecordingBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="PrivateBrush"   Color="#F59E0B" />
    <SolidColorBrush x:Key="OfflineBrush"   Color="#64748B" />
</ResourceDictionary>