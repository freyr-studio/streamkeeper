<ui:FluentWindow x:Class="StreamKeeper.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Settings" Width="620" Height="400" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,0">
            <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"
                       Foreground="{DynamicResource TextPrimaryBrush}" />

            <!-- Dossier d'enregistrement -->
            <TextBlock Text="Recording folder" FontSize="12" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Folder24}" />
                <ui:Button Grid.Column="1" Content="Browse" Margin="8,0,0,0"
                           Command="{Binding BrowseOutputCommand}" />
            </Grid>

            <!-- Thème -->
            <TextBlock Text="Theme" FontSize="12" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                      Width="240" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Boutons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24">
            <ui:Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" />
            <ui:Button Content="Save" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
